---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../content/site";
---

<BaseLayout title={`Apps — ${site.name}`} description="Apps by Phil VDM, including StudyQuest.">
  <div class="page">
    <SiteHeader variant="sub" />

    <main class="apps-page">
      <section class="apps-hero">
        <p class="kicker">Portfolio</p>
        <h1>Apps</h1>
        <p class="lead">Products beyond games — starting with StudyQuest.</p>
      </section>

      <section class="library" aria-label="App library">
        {
          site.apps.map((app, index) => (
            <article
              class:list={["app-card", { featured: app.featured }]}
              id={app.slug}
              style={`--i: ${index}; --sq-navy: ${app.palette?.navy ?? "#0A1628"}; --sq-surface: ${app.palette?.surface ?? "#121D33"}; --sq-purple: ${app.palette?.purple ?? "#8B5CF6"}; --sq-soft: ${app.palette?.soft ?? "#A78BFA"}; --sq-muted: ${app.palette?.muted ?? "#9AA6B8"};`}
            >
              <div class="card-top">
                {app.icon && (
                  <img class="app-icon" src={app.icon} alt="" width="72" height="72" />
                )}
                <div>
                  <p class="status">
                    <span class="dot"></span>
                    {app.status} · {app.kind}
                  </p>
                  <h2>{app.title}</h2>
                  <p class="blurb">{app.blurb}</p>
                  <ul class="tags">
                    {app.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="shots" role="list" aria-label={`${app.title} screenshots`}>
                {app.screenshots.map((shot) => (
                  <figure class="shot" role="listitem">
                    <img src={shot.src} alt={shot.alt} width="360" height="720" />
                  </figure>
                ))}
              </div>

              <div class="details">
                <div>
                  <h3>How it helps</h3>
                  <ul>
                    {app.helps.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3>How to start</h3>
                  <ol>
                    {app.howToStart.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ol>
                </div>
              </div>

              {app.palette && (
                <div class="palette" aria-label="Color palette">
                  <p class="palette-label">Color palette</p>
                  <ul>
                    <li><span style={`background:${app.palette.navy}`}></span>Navy</li>
                    <li><span style={`background:${app.palette.surface}`}></span>Cards</li>
                    <li><span style={`background:${app.palette.purple}`}></span>Purple</li>
                    <li><span style={`background:${app.palette.soft}`}></span>Soft purple</li>
                    <li><span style={`background:${app.palette.muted}`}></span>Muted</li>
                  </ul>
                </div>
              )}
            </article>
          ))
        }
      </section>
    </main>

    <footer class="foot">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <a href="/">Back home</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #fff;
  }

  .apps-page {
    flex: 1;
  }

  .apps-hero {
    padding: 7.5rem var(--space) 2.5rem;
    background: #0a1628;
    color: #fff;
  }

  .kicker {
    margin: 0 0 0.75rem;
    color: #a78bfa;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .apps-hero h1 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .lead {
    margin: 0;
    max-width: 32rem;
    color: #9aa6b8;
    font-size: 1.1rem;
  }

  .library {
    width: min(100%, var(--max));
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--space) 4.5rem;
    display: grid;
    gap: 1.75rem;
  }

  .app-card {
    padding: clamp(1.35rem, 3vw, 2rem);
    border-radius: 2rem;
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(139, 92, 246, 0.18), transparent 55%),
      linear-gradient(160deg, #0a1628 0%, #0b1220 55%, #121d33 100%);
    color: #fff;
    box-shadow: 0 22px 50px rgba(10, 22, 40, 0.28);
    animation: rise 0.75s var(--ease) both;
    animation-delay: calc(var(--i) * 0.1s);
  }

  .card-top {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.15rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }

  .app-icon {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1.15rem;
    object-fit: cover;
    background: #121d33;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.35);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.55rem;
    color: #a78bfa;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.25);
  }

  .card-top h2 {
    margin: 0 0 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .blurb {
    margin: 0 0 1rem;
    color: #9aa6b8;
    font-size: 1.02rem;
    max-width: 42rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.18);
    color: #e9ddff;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .shot {
    margin: 0;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(167, 139, 250, 0.28);
    background: #0b1220;
    aspect-ratio: 9 / 16;
  }

  .shot:last-child {
    aspect-ratio: 1 / 1;
    align-self: center;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.35rem;
  }

  .details h3 {
    margin: 0 0 0.65rem;
    color: #a78bfa;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .details ul,
  .details ol {
    margin: 0;
    padding-left: 1.15rem;
    color: #e8eef8;
    display: grid;
    gap: 0.45rem;
  }

  .palette-label {
    margin: 0 0 0.65rem;
    color: #a78bfa;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .palette ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .palette li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #9aa6b8;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .palette span {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.25rem var(--space);
    background: #050505;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
  }

  .foot p {
    margin: 0;
  }

  .foot a {
    color: #fff;
    text-decoration: none;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shot:last-child {
      aspect-ratio: 9 / 16;
    }

    .details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .card-top {
      grid-template-columns: 1fr;
    }
  }
</style>
