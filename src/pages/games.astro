---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../content/site";
---

<BaseLayout title={`Games — ${site.name}`} description="Games by Phil VDM, starting with Echoes of the Terminal. Also building StudyQuest.">
  <div class="page">
    <SiteHeader variant="sub" />

    <main class="games-page">
      <section class="games-hero">
        <div class="bubbles" aria-hidden="true">
          <span class="bubble b1"></span>
          <span class="bubble b2"></span>
          <span class="bubble b3"></span>
          <span class="bubble b4"></span>
          <span class="bubble b5"></span>
          <span class="bubble b6"></span>
        </div>
        <p class="kicker">Portfolio</p>
        <h1>Games</h1>
        <p class="lead">Titles in progress and on the way.</p>
      </section>

      <section class="library" aria-label="Game library">
        {
          site.games.map((game, index) => (
            <article
              class:list={["game-card", `shade-${(index % 3) + 1}`, { featured: game.featured }]}
              id={game.slug}
              style={`--i: ${index}`}
            >
              <div class="card-bubbles" aria-hidden="true">
                <span class="orb o1"></span>
                <span class="orb o2"></span>
                <span class="orb o3"></span>
              </div>

              <div class="card-media teaser">
                <p class="teaser-badge">{game.teaserLabel ?? "Teaser"}</p>
                <div class="teaser-grid" role="list" aria-label={`${game.title} screenshots`}>
                  {
                    (game.screenshots ?? [{ src: game.image, alt: `${game.title} artwork` }]).map((shot) => (
                      <figure class="shot-solo" role="listitem">
                        <img src={shot.src} alt={shot.alt} width="640" height="400" />
                      </figure>
                    ))
                  }
                </div>
              </div>

              <div class="card-copy">
                <p class="status">
                  <span class="dot"></span>
                  {game.status}
                </p>
                <h2>{game.title}</h2>
                <p class="blurb">{game.blurb}</p>
                <ul class="tags">
                  {game.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <p class="year">{game.year}</p>
              </div>
            </article>
          ))
        }
      </section>
    </main>

    <footer class="foot">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <a href="/">Back home</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .games-page {
    flex: 1;
  }

  .games-hero {
    position: relative;
    overflow: hidden;
    padding: 7.5rem var(--space) 3rem;
    background: #ffffff;
    color: var(--ink);
  }

  .bubbles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bubble {
    position: absolute;
    border-radius: 50%;
    animation: float 10s var(--ease) infinite alternate;
  }

  .b1 {
    width: 9rem;
    height: 9rem;
    left: 8%;
    top: 20%;
    background: rgba(10, 47, 138, 0.08);
    animation-duration: 11s;
  }

  .b2 {
    width: 14rem;
    height: 14rem;
    right: 6%;
    top: -2rem;
    background: rgba(10, 47, 138, 0.08);
    animation-duration: 14s;
    animation-delay: -2s;
  }

  .b3 {
    width: 5rem;
    height: 5rem;
    right: 28%;
    bottom: 18%;
    background: rgba(10, 47, 138, 0.1);
    animation-duration: 9s;
    animation-delay: -1s;
  }

  .b4 {
    width: 3.5rem;
    height: 3.5rem;
    left: 35%;
    top: 35%;
    background: rgba(10, 47, 138, 0.12);
    animation-duration: 8s;
  }

  .b5 {
    width: 7rem;
    height: 7rem;
    left: -1rem;
    bottom: -1rem;
    background: rgba(10, 47, 138, 0.06);
    animation-duration: 12s;
  }

  .b6 {
    width: 2.5rem;
    height: 2.5rem;
    right: 40%;
    top: 25%;
    background: rgba(255, 255, 255, 0.2);
    animation-duration: 7s;
  }

  .kicker {
    position: relative;
    margin: 0 0 0.75rem;
    color: var(--ocean);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .games-hero h1 {
    position: relative;
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--ink);
  }

  .lead {
    position: relative;
    margin: 0;
    max-width: 28rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .library {
    width: min(100%, var(--max));
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--space) 4.5rem;
    display: grid;
    gap: 1.75rem;
  }

  .game-card {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 2rem;
    overflow: hidden;
    isolation: isolate;
    scroll-margin-top: 5.5rem;
    animation: bubble-in 0.8s var(--ease) both;
    animation-delay: calc(var(--i) * 0.12s);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .game-card:hover {
    transform: translateY(-6px) scale(1.01);
  }

  .shade-1 {
    background: linear-gradient(145deg, #ffffff 0%, #edf3ff 55%, #dce7fb 100%);
    box-shadow: 0 18px 40px rgba(10, 47, 138, 0.12);
  }

  .shade-2 {
    background: linear-gradient(145deg, #f7f9fd 0%, #e4ecfa 100%);
    box-shadow: 0 18px 40px rgba(7, 31, 92, 0.1);
  }

  .shade-3 {
    background: linear-gradient(145deg, #fffdf5 0%, #f0f4fc 60%, #e8eef8 100%);
    box-shadow: 0 18px 40px rgba(10, 47, 138, 0.1);
  }

  .game-card.featured {
    border: 1px solid rgba(10, 47, 138, 0.16);
  }

  .card-bubbles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    transition: transform 0.5s var(--ease);
  }

  .game-card:hover .o1 {
    transform: translate(-8px, -10px) scale(1.08);
  }

  .game-card:hover .o2 {
    transform: translate(10px, 6px) scale(1.12);
  }

  .game-card:hover .o3 {
    transform: translate(-4px, 12px) scale(0.95);
  }

  .shade-1 .o1 {
    width: 8rem;
    height: 8rem;
    right: -1.5rem;
    top: -1.5rem;
    background: rgba(10, 47, 138, 0.1);
  }

  .shade-1 .o2 {
    width: 4.5rem;
    height: 4.5rem;
    left: 42%;
    bottom: -1rem;
    background: rgba(10, 47, 138, 0.1);
  }

  .shade-1 .o3 {
    width: 2.5rem;
    height: 2.5rem;
    left: 8%;
    top: 12%;
    background: rgba(255, 255, 255, 0.8);
  }

  .shade-2 .o1 {
    width: 10rem;
    height: 10rem;
    right: -2rem;
    bottom: -2rem;
    background: rgba(7, 31, 92, 0.12);
  }

  .shade-2 .o2 {
    width: 3rem;
    height: 3rem;
    right: 30%;
    top: 10%;
    background: rgba(10, 47, 138, 0.12);
  }

  .shade-2 .o3 {
    width: 5rem;
    height: 5rem;
    left: -1rem;
    top: 40%;
    background: rgba(255, 255, 255, 0.55);
  }

  .shade-3 .o1 {
    width: 7rem;
    height: 7rem;
    right: 10%;
    top: -2rem;
    background: rgba(255, 255, 255, 0.18);
  }

  .shade-3 .o2 {
    width: 9rem;
    height: 9rem;
    left: -2rem;
    bottom: -2rem;
    background: rgba(10, 47, 138, 0.08);
  }

  .shade-3 .o3 {
    width: 2rem;
    height: 2rem;
    right: 20%;
    bottom: 20%;
    background: #fff;
  }

  .card-media,
  .card-copy {
    position: relative;
    z-index: 1;
  }

  .card-media {
    position: relative;
    overflow: hidden;
    border-radius: 1.35rem;
    background: #050505;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
  }

  .teaser-badge {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 2;
    margin: 0;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(120, 255, 160, 0.55);
    background: rgba(0, 12, 6, 0.78);
    color: #8dffb0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .teaser-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    padding: 0.45rem;
  }

  .shot-solo {
    margin: 0;
    overflow: hidden;
    border-radius: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #111;
    aspect-ratio: 16 / 10;
    transition:
      transform 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .shot-solo:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .shot-solo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shot-solo:hover {
    transform: translateY(-3px);
    border-color: rgba(120, 255, 160, 0.55);
  }

  @media (max-width: 560px) {
    .teaser-grid {
      grid-template-columns: 1fr;
    }

    .shot-solo:first-child {
      grid-column: auto;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.75rem;
    color: var(--ocean);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ocean);
    box-shadow: 0 0 0 3px rgba(10, 47, 138, 0.18);
    animation: pulse 2.2s ease-in-out infinite;
  }

  .card-copy h2 {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3.4vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .blurb {
    margin: 0 0 1.1rem;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 0.85rem;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(10, 47, 138, 0.08);
    color: var(--ocean-deep);
    font-size: 0.78rem;
    font-weight: 700;
    transition:
      background 0.25s var(--ease),
      color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .game-card:hover .tags li {
    background: var(--ocean);
    color: #fff;
    transform: translateY(-2px);
  }

  .tags li:nth-child(2) {
    transition-delay: 0.04s;
  }

  .tags li:nth-child(3) {
    transition-delay: 0.08s;
  }

  .year {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.25rem var(--space);
    background: #050505;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
  }

  .foot p {
    margin: 0;
  }

  .foot a {
    color: #fff;
    text-decoration: none;
  }

  @keyframes float {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -14px, 0);
    }
  }

  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px rgba(10, 47, 138, 0.18);
    }
    50% {
      box-shadow: 0 0 0 7px rgba(10, 47, 138, 0.08);
    }
  }

  @media (max-width: 860px) {
    .game-card {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble,
    .dot,
    .game-card {
      animation: none;
    }

    .game-card:hover,
    .game-card:hover .card-media,
    .game-card:hover .orb,
    .game-card:hover .tags li {
      transform: none;
    }
  }
</style>
