---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../content/site";
---

<BaseLayout title={`About Me — ${site.name}`} description={site.about.intro}>
  <div class="page">
    <SiteHeader variant="sub" />

    <main class="about-page">
      <section class="about-hero">
        <div class="portrait-wrap">
          <img
            class="portrait"
            src={site.about.profileImage}
            alt={`${site.name} profile photo`}
            width="640"
            height="640"
          />
        </div>

        <div class="hero-copy">
          <p class="kicker">A little about me</p>
          <h1>{site.about.headline}</h1>
          <p class="intro">{site.about.intro}</p>
        </div>
      </section>

      <section class="about-body">
        {
          site.about.paragraphs.map((p) => (
            <p>{p}</p>
          ))
        }

        <dl class="facts">
          {
            site.about.facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="actions">
          <a class="btn btn-primary" href="/#echoes-of-the-terminal">See Echoes</a>
          <a class="btn btn-ghost" href="/apps#studyquest">See StudyQuest</a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}>Email me</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <a href="/">Back home</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #fff;
  }

  .about-page {
    flex: 1;
  }

  .about-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: 7.5rem var(--space) 3rem;
    background: var(--ocean);
    color: #fff;
  }

  .portrait-wrap {
    width: min(42vw, 17rem);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.35);
    background: var(--ocean-deep);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: grayscale(1) contrast(1.05);
  }

  .kicker {
    margin: 0 0 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .intro {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.86);
  }

  .about-body {
    width: min(100%, 42rem);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--space) 4rem;
  }

  .about-body > p {
    margin: 0 0 1.15rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .facts {
    display: grid;
    gap: 0.85rem;
    margin: 2rem 0 2.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .fact {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.75rem;
  }

  .fact dt {
    margin: 0;
    color: var(--ocean);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .fact dd {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--ocean);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--ocean-deep);
  }

  .btn-ghost {
    border-color: var(--line);
    color: var(--ink);
    background: #fff;
  }

  .btn-ghost:hover {
    border-color: var(--ocean);
    color: var(--ocean);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.25rem var(--space);
    background: #050505;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
  }

  .foot p {
    margin: 0;
  }

  .foot a {
    color: #fff;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .about-hero {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .portrait-wrap {
      width: min(70vw, 14rem);
    }

    .intro {
      margin-inline: auto;
    }
  }
</style>
