---
import { site } from "../content/site";

interface Props {
  variant?: "home" | "sub";
}

const { variant = "home" } = Astro.props;
const gamesHref = variant === "home" ? "#games" : "/#games";
const appsHref = variant === "home" ? "#apps" : "/apps";
const aboutHref = variant === "home" ? "#about" : "/about";
const contactHref = variant === "home" ? "#email" : "/#email";
const homeHref = variant === "home" ? "#top" : "/";
---

<header class="top">
  <a class="mark" href={homeHref}>{site.shortName}</a>
  <nav class="nav" aria-label="Primary">
    <a class="nav-btn" href={gamesHref}>Games</a>
    <a class="nav-btn" href={appsHref}>Apps</a>
    <a class="nav-btn" href={aboutHref}>About Me</a>
    <a class="nav-btn" href={contactHref}>Contact</a>
  </nav>
</header>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem var(--space);
    background: linear-gradient(to bottom, rgba(7, 31, 92, 0.92), rgba(7, 31, 92, 0));
    color: #fff;
  }

  .mark {
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .nav a {
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .nav a:hover {
    color: #fff;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.2rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff !important;
    font-weight: 700 !important;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .nav-btn:hover {
    background: #fff;
    border-color: #fff;
    color: var(--ink) !important;
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-btn:hover {
      transform: none;
    }
  }
</style>
